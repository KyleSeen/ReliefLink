<%- include('partials/header') %>

<% if (typeof notFound !== 'undefined' && notFound) { %>
  <div class="inset" style="border-left-color:var(--red)">
    <strong style="color:var(--red)">That page was not found. This is the ReliefLink home page.</strong>
  </div>
<% } %>

<h1>Coordinate disaster relief in one place</h1>
<p>ReliefLink connects the people who need help, the coordinators who organise the
response, the volunteers who deliver it, and the donors who replace what is used.</p>

<% if (currentUser) { %>
  <p><a href="/<%= currentUser.role %>/dashboard" class="btn">Go to your dashboard</a></p>
<% } else { %>
  <p>
    <a href="/login" class="btn">Sign in</a>
    <a href="/register" class="btn blue">Register</a>
  </p>
<% } %>

<h2 class="section-title">How the service works</h2>
<div class="chain">
  <div class="cell"><div class="step">Step 1</div><div class="role">Victim</div><div class="does">Asks for help and finds a shelter.</div></div>
  <div class="cell"><div class="step">Step 2</div><div class="role">Coordinator</div><div class="does">Raises a task from each request.</div></div>
  <div class="cell"><div class="step">Step 3</div><div class="role">Volunteer</div><div class="does">Delivers help in the field.</div></div>
  <div class="cell"><div class="step">Step 4</div><div class="role">Donor</div><div class="does">Replaces what was used.</div></div>
</div>

<%- include('partials/footer') %>
