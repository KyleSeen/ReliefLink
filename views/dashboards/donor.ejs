<%- include('../partials/header') %>

<%
  function meterClass(occ, cap){ var p = cap > 0 ? occ / cap * 100 : 100; return p >= 100 ? 'full' : (p >= 75 ? 'warn' : ''); }
  function meterPct(occ, cap){ return cap > 0 ? Math.min(Math.round(occ / cap * 100), 100) : 100; }
  function shelterStatusTag(s){ return s === 'full' ? 'red' : (s === 'closed' ? 'grey' : 'green'); }
  function shelterStatusLabel(s){ return s === 'full' ? 'Full' : (s === 'closed' ? 'Closed' : 'Taking people'); }
%>

<% if (ok) { %>
  <div class="toast"><div class="head">Done</div><div class="body"><%= ok %></div></div>
<% } else if (err) { %>
  <div class="toast err"><div class="head">There is a problem</div><div class="body"><%= err %></div></div>
<% } %>

<%- include('../partials/chain') %>

<h1>Donor dashboard</h1>

<% if (stats.categoriesShort > 0) { %>
  <div class="banner"><div class="head">Action needed</div>
    <div class="body"><%= stats.categoriesShort %> categor<%= stats.categoriesShort === 1 ? 'y is' : 'ies are' %> short of what is needed.</div>
  </div>
<% } %>

<div class="stats">
  <div class="stat"><div class="num mono"><%= stats.pledges %></div><div class="lbl">Your pledges</div></div>
  <div class="stat green"><div class="num mono"><%= stats.unitsPledged %></div><div class="lbl">Units pledged</div></div>
  <div class="stat <%= stats.categoriesShort > 0 ? 'red' : '' %>"><div class="num mono"><%= stats.categoriesShort %></div><div class="lbl">Categories short</div></div>
</div>

<!-- Donor features (Owner: Yap Sin Ni): pledge donations, resource-need shortfall -->
<div data-tabs="<%= tab %>">
  <div class="tabs">
    <button class="tab-btn" data-target="donations">Pledge donations</button>
    <button class="tab-btn" data-target="needs">Resource needs</button>
  </div>

  <!-- Pledge donations -->
  <div class="tab-pane" id="donations">
    <div class="panel">
      <h3>Pledge a donation</h3>
      <form action="/donor/donations" method="POST" class="form-row">
        <div class="field"><label>Category</label>
          <select name="item_type" required>
            <option value="" disabled selected>Choose a category</option>
            <% needTypes.forEach(function(n){ %><option value="<%= n %>"><%= n %></option><% }); %>
          </select>
        </div>
        <div class="field narrow"><label>Quantity (units)</label><input type="number" name="quantity" min="1" required></div>
        <div class="field narrow"><button class="btn">Pledge</button></div>
      </form>
    </div>

    <% if (donations.length === 0) { %>
      <p class="muted">You have not pledged anything yet.</p>
    <% } else { %>
      <table>
        <caption>Your pledges (<%= donations.length %>).</caption>
        <thead><tr><th>Item and quantity</th><th>Status</th><th>Date</th><th></th></tr></thead>
        <tbody>
          <% donations.forEach(function(d){ %>
            <tr>
              <td data-label="Item">
                <% if (d.status === 'pledged') { %>
                  <form action="/donor/donations/<%= d.id %>/update" method="POST" class="form-row">
                    <div class="field narrow" style="flex:0 1 130px">
                      <select name="item_type">
                        <% needTypes.forEach(function(n){ %><option value="<%= n %>" <%= d.item_type === n ? 'selected' : '' %>><%= n %></option><% }); %>
                      </select>
                    </div>
                    <div class="field narrow" style="flex:0 1 90px"><input type="number" name="quantity" min="1" value="<%= d.quantity %>"></div>
                    <div class="field narrow"><button class="btn sm blue">Save</button></div>
                  </form>
                <% } else { %>
                  <strong><%= d.item_type %></strong> <span class="mono"><%= d.quantity %></span>
                <% } %>
              </td>
              <td data-label="Status"><span class="tag <%= d.status === 'received' ? 'green' : 'grey' %>"><%= d.status %></span></td>
              <td data-label="Date"><%= new Date(d.created_at).toLocaleDateString() %></td>
              <td data-label="">
                <% if (d.status === 'pledged') { %>
                  <form action="/donor/donations/<%= d.id %>/delete" method="POST" class="inline-form"
                        onsubmit="return confirm('Withdraw this pledge?');">
                    <button class="link-danger">Withdraw</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

  <!-- Resource needs -->
  <div class="tab-pane" id="needs">
    <h2 class="section-title">Where donations are needed most</h2>
    <p class="need-intro">Categories with unmet need, largest gap first.</p>
    <% if (shortfall.length === 0) { %>
      <div class="inset">All current requests are covered by pledged donations.</div>
    <% } else { %>
      <% shortfall.forEach(function(s){
           var needed = Number(s.units_needed) || 0;
           var pledged = Number(s.units_pledged) || 0;
           var short = Number(s.shortfall) || 0;
           var pct = needed > 0 ? Math.min(Math.max(Math.round(short / needed * 100), 0), 100) : 0;
      %>
        <div class="need-row">
          <div class="need-left">
            <div class="cat"><%= s.category %></div>
            <div class="sub"><span class="mono"><%= needed %></span> units needed &middot; <span class="mono"><%= pledged %></span> pledged</div>
          </div>
          <div class="need-mid">
            <div class="need-bar">
              <% if (short > 0) { %><span style="width:<%= pct %>%"></span><% } else { %><span class="covered" style="width:100%"></span><% } %>
            </div>
          </div>
          <div class="need-right"><% if (short > 0) { %><%= short %> short<% } else { %>Covered<% } %></div>
        </div>
      <% }); %>
    <% } %>

    <h2 class="section-title" style="margin-top:26px">Shelter occupancy</h2>
    <% if (shelters.length === 0) { %>
      <div class="inset">No shelters have been added yet.</div>
    <% } else { %>
      <table>
        <caption>Shelters and how full they are (<%= shelters.length %>).</caption>
        <thead><tr><th>Shelter</th><th>Location</th><th>Occupancy</th><th>Spaces left</th><th>Status</th></tr></thead>
        <tbody>
          <% shelters.forEach(function(s){ %>
            <tr>
              <td data-label="Shelter"><strong><%= s.name %></strong></td>
              <td data-label="Location"><%= s.location %></td>
              <td data-label="Occupancy">
                <div class="meter"><div class="fill <%= meterClass(s.current_occupancy, s.capacity) %>" style="width:<%= meterPct(s.current_occupancy, s.capacity) %>%"></div></div>
                <div class="meter-cap"><%= s.current_occupancy %> of <%= s.capacity %></div>
              </td>
              <td data-label="Spaces left"><span class="mono"><%= s.spots_left %></span></td>
              <td data-label="Status"><span class="tag <%= shelterStatusTag(s.status) %>"><%= shelterStatusLabel(s.status) %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
