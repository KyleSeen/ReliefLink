<%- include('../partials/header') %>

<%
  function donationBadge(s){
    return s === 'received' ? 'bg-success' : 'bg-secondary';
  }
  function shelterBadge(s){
    return s === 'open' ? 'bg-success' : (s === 'full' ? 'bg-warning text-dark' : 'bg-secondary');
  }
%>

<div class="rl-dash-header">
  <div class="container">
    <h1 class="h3 mb-1">Donor Dashboard</h1>
    <p class="mb-0 text-white-50">Logged in as <%= currentUser.name %></p>
  </div>
</div>

<div class="container py-4">

  <!-- Flash messages -->
  <% if (ok) { %>
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i><%= ok %></div>
  <% } %>
  <% if (err) { %>
    <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle me-1"></i><%= err %></div>
  <% } %>

  <!-- Quick stats -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
      <div class="card rl-card text-center"><div class="card-body py-3">
        <div class="h4 mb-0 text-primary"><%= donations.length %></div>
        <small class="text-muted">Your Pledges</small>
      </div></div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card rl-card text-center"><div class="card-body py-3">
        <div class="h4 mb-0 text-primary"><%= donations.filter(d => d.status === 'received').length %></div>
        <small class="text-muted">Received</small>
      </div></div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card rl-card text-center"><div class="card-body py-3">
        <div class="h4 mb-0 text-primary"><%= shelters.length %></div>
        <small class="text-muted">Shelters</small>
      </div></div>
    </div>
  </div>

  <!-- ============================================= -->
  <!-- DONOR FUNCTIONALITIES (Owner: Yap Sin Ni)     -->
  <!-- 1) Pledge Donations   2) Resource-Need View   -->
  <!-- ============================================= -->

  <ul class="nav nav-tabs mb-0" id="donorTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= tab === 'donations' ? 'active' : '' %>" id="donations-tab"
              data-bs-toggle="tab" data-bs-target="#donations-pane" type="button" role="tab">
        <i class="bi bi-gift me-1"></i>Pledge Donations
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= tab === 'shelters' ? 'active' : '' %>" id="shelters-tab"
              data-bs-toggle="tab" data-bs-target="#shelters-pane" type="button" role="tab">
        <i class="bi bi-house-heart me-1"></i>Resource-Need Dashboard
      </button>
    </li>
  </ul>

  <div class="tab-content feature-area rounded-0 rounded-bottom">

    <!-- ================= TAB 1: PLEDGE DONATIONS ================= -->
    <div class="tab-pane fade <%= tab === 'donations' ? 'show active' : '' %>" id="donations-pane" role="tabpanel">

      <h5 class="mb-3"><i class="bi bi-plus-circle me-1"></i>Pledge a donation</h5>
      <form action="/donor/donations" method="POST" class="row g-2 align-items-end mb-4">
        <div class="col-md-5">
          <label class="form-label">Item type</label>
          <input type="text" name="item_type" class="form-control" placeholder="e.g. Money, Food, Water" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Quantity</label>
          <input type="number" name="quantity" class="form-control" min="1" placeholder="e.g. 100" required>
        </div>
        <div class="col-md-3">
          <button type="submit" class="btn rl-btn-primary w-100">Pledge</button>
        </div>
      </form>

      <h5 class="mb-3"><i class="bi bi-clock-history me-1"></i>Your donation history</h5>
      <% if (donations.length === 0) { %>
        <p class="text-muted">You haven't pledged anything yet. Add one above.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Item</th><th>Quantity</th><th>Status</th><th>Date</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% donations.forEach(function(d){ %>
                <tr>
                  <td class="fw-semibold"><%= d.item_type %></td>
                  <td><%= d.quantity %></td>
                  <td><span class="badge <%= donationBadge(d.status) %>"><%= d.status %></span></td>
                  <td><%= new Date(d.created_at).toLocaleDateString() %></td>
                  <td class="text-end">
                    <% if (d.status === 'pledged') { %>
                      <form action="/donor/donations/<%= d.id %>/delete" method="POST"
                            onsubmit="return confirm('Cancel this pledge?');">
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- ================= TAB 2: RESOURCE-NEED DASHBOARD ================= -->
    <div class="tab-pane fade <%= tab === 'shelters' ? 'show active' : '' %>" id="shelters-pane" role="tabpanel">

      <h5 class="mb-3"><i class="bi bi-graph-up me-1"></i>Where help is needed most</h5>
      <% if (shelters.length === 0) { %>
        <p class="text-muted">No shelter data available yet.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Shelter</th><th>Location</th><th>Capacity</th>
                <th>Occupancy</th><th>Spots Left</th><th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% shelters.forEach(function(s){ %>
                <tr>
                  <td class="fw-semibold"><%= s.name %></td>
                  <td><%= s.location %></td>
                  <td><%= s.capacity %></td>
                  <td><%= s.current_occupancy %></td>
                  <td><%= s.spots_left %></td>
                  <td><span class="badge <%= shelterBadge(s.status) %>"><%= s.status %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>