<%- include('../partials/header') %>

<%
  function requestTag(s){ return s === 'pending' ? 'red' : (s === 'assigned' ? 'orange' : 'green'); }
  function reportTag(s){ return s === 'submitted' ? 'red' : (s === 'in_progress' ? 'orange' : 'green'); }
  function meterClass(occ, cap){ var p = cap > 0 ? occ / cap * 100 : 100; return p >= 100 ? 'full' : (p >= 75 ? 'warn' : ''); }
  function meterPct(occ, cap){ return cap > 0 ? Math.min(Math.round(occ / cap * 100), 100) : 100; }
%>

<% if (ok) { %>
  <div class="toast"><div class="head">Done</div><div class="body"><%= ok %></div></div>
<% } else if (err) { %>
  <div class="toast err"><div class="head">There is a problem</div><div class="body"><%= err %></div></div>
<% } %>

<%- include('../partials/chain') %>

<h1>Get help</h1>

<div class="stats">
  <div class="stat <%= stats.activeRequests > 0 ? 'red' : '' %>"><div class="num mono"><%= stats.activeRequests %></div><div class="lbl">Active requests</div></div>
  <div class="stat green"><div class="num mono"><%= stats.sheltersWithSpace %></div><div class="lbl">Shelters with space</div></div>
  <div class="stat"><div class="num mono"><%= stats.openReports %></div><div class="lbl">Open reports</div></div>
  <div class="stat green"><div class="num mono"><%= stats.resolved %></div><div class="lbl">Resolved</div></div>
</div>

<!-- Victim features (Owner: Seen Man Hong): aid requests, shelter finder, incident reports -->
<div data-tabs="<%= tab %>">
  <div class="tabs">
    <button class="tab-btn" data-target="shelter">Ask for help</button>
    <button class="tab-btn" data-target="reports">Emergency reports</button>
  </div>

  <!-- Ask for help and find shelter -->
  <div class="tab-pane" id="shelter">
    <div class="panel">
      <h3>Ask for help</h3>
      <form action="/victim/aid-requests" method="POST" class="form-row">
        <div class="field narrow"><label>What you need</label>
          <select name="need_type" required>
            <option value="" disabled selected>Choose</option>
            <% needTypes.forEach(function(n){ %><option value="<%= n %>"><%= n %></option><% }); %>
          </select>
        </div>
        <div class="field narrow"><label>How many people</label><input type="number" name="people_count" min="1" max="500" required></div>
        <div class="field"><label>Preferred shelter</label>
          <select name="shelter_id"><option value="">No preference</option>
            <% shelterOptions.forEach(function(s){ %><option value="<%= s.id %>"><%= s.name %> (<%= s.location %>, <%= s.status %>)</option><% }); %>
          </select>
        </div>
        <div class="field narrow"><button class="btn">Send request</button></div>
      </form>
    </div>

    <h2 class="section-title">Find a shelter</h2>
    <form action="/victim/dashboard" method="GET" class="form-row" style="margin-bottom:18px">
      <input type="hidden" name="tab" value="shelter">
      <div class="field"><label>Search by name or area</label>
        <input type="text" name="q" value="<%= q %>" placeholder="e.g. Sector 4, Riverside, or leave blank to see all">
      </div>
      <div class="field narrow"><button class="btn blue">Search</button></div>
    </form>

    <% if (shelters.length === 0) { %>
      <p class="muted">No shelters match your search.</p>
    <% } else { %>
      <table>
        <caption>Open shelters, emptiest first (<%= shelters.length %>).</caption>
        <thead><tr><th>Shelter</th><th>Location</th><th>Space</th><th>Status</th></tr></thead>
        <tbody>
          <% shelters.forEach(function(s){ %>
            <tr>
              <td data-label="Shelter"><strong><%= s.name %></strong></td>
              <td data-label="Location"><%= s.location %></td>
              <td data-label="Space">
                <div class="meter"><div class="fill <%= meterClass(s.current_occupancy, s.capacity) %>" style="width:<%= meterPct(s.current_occupancy, s.capacity) %>%"></div></div>
                <div class="meter-cap"><%= s.free_spaces %> free of <%= s.capacity %></div>
              </td>
              <td data-label="Status"><span class="tag <%= s.status === 'full' ? 'red' : 'green' %>"><%= s.status === 'full' ? 'Full' : 'Taking people' %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>

    <h2 class="section-title" style="margin-top:26px">Your requests</h2>
    <% if (requests.length === 0) { %>
      <p class="muted">You have not asked for help yet.</p>
    <% } else { %>
      <table>
        <caption>Requests you have sent (<%= requests.length %>).</caption>
        <thead><tr><th>What and how many</th><th>Shelter</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% requests.forEach(function(r){ %>
            <tr>
              <td data-label="Request">
                <% if (r.status === 'pending') { %>
                  <form action="/victim/aid-requests/<%= r.id %>/update" method="POST" class="form-row">
                    <div class="field narrow" style="flex:0 1 120px">
                      <select name="need_type">
                        <% needTypes.forEach(function(n){ %><option value="<%= n %>" <%= r.need_type === n ? 'selected' : '' %>><%= n %></option><% }); %>
                      </select>
                    </div>
                    <div class="field narrow" style="flex:0 1 80px"><input type="number" name="people_count" min="1" max="500" value="<%= r.people_count %>"></div>
                    <div class="field narrow" style="flex:1 1 160px">
                      <select name="shelter_id">
                        <option value="">No preference</option>
                        <% shelterOptions.forEach(function(s){ %><option value="<%= s.id %>" <%= r.shelter_id === s.id ? 'selected' : '' %>><%= s.name %></option><% }); %>
                        <% if (r.shelter_id && !shelterOptions.some(function(s){ return s.id === r.shelter_id; })) { %>
                          <option value="<%= r.shelter_id %>" selected><%= r.shelter_name %> (closed)</option>
                        <% } %>
                      </select>
                    </div>
                    <div class="field narrow"><button class="btn sm blue">Save</button></div>
                  </form>
                <% } else { %>
                  <strong style="text-transform:capitalize"><%= r.need_type %></strong>
                  &middot; <span class="mono"><%= r.people_count %></span> <%= r.people_count === 1 ? 'person' : 'people' %>
                <% } %>
              </td>
              <td data-label="Shelter"><%= r.shelter_name ? r.shelter_name : 'None yet' %></td>
              <td data-label="Status"><span class="tag <%= requestTag(r.status) %>"><%= r.status %></span></td>
              <td data-label="">
                <% if (r.status === 'pending') { %>
                  <form action="/victim/aid-requests/<%= r.id %>/delete" method="POST" class="inline-form"
                        onsubmit="return confirm('Withdraw this request?');">
                    <button class="link-danger">Withdraw</button>
                  </form>
                <% } else { %>
                  <span class="muted">A coordinator is handling this.</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

  <!-- Emergency reports -->
  <div class="tab-pane" id="reports">
    <div class="panel">
      <h3>Report an emergency</h3>
      <form action="/victim/reports" method="POST">
        <div class="form-row">
          <div class="field narrow"><label>Type</label>
            <select name="type" required>
              <option value="" disabled selected>Choose</option>
              <% incidentTypes.forEach(function(t){ %><option value="<%= t %>"><%= t %></option><% }); %>
            </select>
          </div>
          <div class="field"><label>Where it is</label><input type="text" name="location" required></div>
        </div>
        <div class="field"><label>What is happening</label>
          <div class="hint">At least 10 characters.</div>
          <textarea name="description" rows="3" required></textarea>
        </div>
        <button class="btn">Send report</button>
      </form>
    </div>

    <h2 class="section-title">Your reports</h2>
    <% if (reports.length === 0) { %>
      <p class="muted">You have not filed any reports.</p>
    <% } else { %>
      <table>
        <caption>Reports you have filed (<%= reports.length %>).</caption>
        <thead><tr><th>Report</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% reports.forEach(function(r){ %>
            <tr>
              <td data-label="Report">
                <% if (r.status === 'submitted') { %>
                  <form action="/victim/reports/<%= r.id %>/update" method="POST">
                    <div class="form-row">
                      <div class="field narrow" style="flex:0 1 150px">
                        <select name="type">
                          <% incidentTypes.forEach(function(t){ %><option value="<%= t %>" <%= r.type === t ? 'selected' : '' %>><%= t %></option><% }); %>
                        </select>
                      </div>
                      <div class="field"><input type="text" name="location" value="<%= r.location %>"></div>
                    </div>
                    <div class="field"><textarea name="description" rows="2"><%= r.description %></textarea></div>
                    <button class="btn sm blue">Save</button>
                  </form>
                <% } else { %>
                  <strong style="text-transform:capitalize"><%= r.type %></strong> &middot; <%= r.location %>
                  <div class="muted"><%= r.description %></div>
                <% } %>
              </td>
              <td data-label="Status"><span class="tag <%= reportTag(r.status) %>"><%= r.status.replace('_',' ') %></span></td>
              <td data-label="">
                <% if (r.status === 'submitted') { %>
                  <form action="/victim/reports/<%= r.id %>/delete" method="POST" class="inline-form"
                        onsubmit="return confirm('Retract this report?');">
                    <button class="link-danger">Retract</button>
                  </form>
                <% } else { %>
                  <span class="muted">Responders are acting on this.</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
