<%- include('../partials/header') %>

<%
  // Small helpers for coloured status badges
  function requestBadge(s){
    if (s === 'pending')  return 'bg-warning text-dark';
    if (s === 'assigned') return 'bg-info text-dark';
    if (s === 'resolved') return 'bg-success';
    return 'bg-secondary';
  }
  function reportBadge(s){
    if (s === 'submitted')   return 'bg-warning text-dark';
    if (s === 'in_progress') return 'bg-primary';
    if (s === 'resolved')    return 'bg-success';
    return 'bg-secondary';
  }
  function shelterBadge(s){
    return s === 'open' ? 'bg-success' : (s === 'full' ? 'bg-warning text-dark' : 'bg-secondary');
  }
  // Occupancy % for the availability bar.
  function occupancyPct(s){
    if (!s.capacity || s.capacity <= 0) return 100;
    return Math.min(100, Math.round((s.current_occupancy / s.capacity) * 100));
  }
  function barColour(pct){
    if (pct >= 100) return 'bg-danger';
    if (pct >= 75)  return 'bg-warning';
    return 'bg-success';
  }
%>

<div class="rl-dash-header">
  <div class="container">
    <span class="rl-role-badge mb-2"><i class="bi bi-people me-1"></i>Victim</span>
    <h1 class="h3 mb-0">Welcome, <%= currentUser.name %> — Victim Dashboard</h1>
    <p class="mb-0 text-white-50">Request aid, find shelter, and report incidents.</p>
  </div>
</div>

<div class="container py-4">

  <!-- Flash messages -->
  <% if (ok) { %>
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i><%= ok %></div>
  <% } %>
  <% if (err) { %>
    <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle me-1"></i><%= err %></div>
  <% } %>

  <!-- Quick stats -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card rl-card text-center"><div class="card-body py-3">
        <div class="h4 mb-0 text-primary"><%= requests.filter(r => r.status !== 'resolved').length %></div>
        <small class="text-muted">Active aid requests</small>
      </div></div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card rl-card text-center"><div class="card-body py-3">
        <div class="h4 mb-0 text-primary"><%= shelters.filter(s => s.status === 'open' && s.free_spaces > 0).length %></div>
        <small class="text-muted">Shelters with space</small>
      </div></div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card rl-card text-center"><div class="card-body py-3">
        <div class="h4 mb-0 text-primary"><%= reports.filter(r => r.status !== 'resolved').length %></div>
        <small class="text-muted">Open reports</small>
      </div></div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card rl-card text-center"><div class="card-body py-3">
        <div class="h4 mb-0 text-primary"><%= requests.filter(r => r.status === 'resolved').length + reports.filter(r => r.status === 'resolved').length %></div>
        <small class="text-muted">Resolved</small>
      </div></div>
    </div>
  </div>

  <!-- ============================================= -->
  <!-- VICTIM FUNCTIONALITIES (Owner: Seen Man Hong) -->
  <!-- 1) Register for Aid + Find Shelter            -->
  <!-- 2) Submit & Track Emergency Reports           -->
  <!-- ============================================= -->

  <!-- Tab bar -->
  <ul class="nav nav-tabs mb-0" id="victimTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= tab === 'shelter' ? 'active' : '' %>" id="shelter-tab"
              data-bs-toggle="tab" data-bs-target="#shelter-pane" type="button" role="tab">
        <i class="bi bi-house-heart me-1"></i>Register for Aid &amp; Find Shelter
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= tab === 'reports' ? 'active' : '' %>" id="reports-tab"
              data-bs-toggle="tab" data-bs-target="#reports-pane" type="button" role="tab">
        <i class="bi bi-exclamation-octagon me-1"></i>Emergency Reports
      </button>
    </li>
  </ul>

  <div class="tab-content feature-area rounded-0 rounded-bottom">

    <!-- ========== TAB 1: REGISTER FOR AID & FIND SHELTER ========== -->
    <div class="tab-pane fade <%= tab === 'shelter' ? 'show active' : '' %>" id="shelter-pane" role="tabpanel">

      <!-- ---------- Shelter finder ---------- -->
      <h5 class="mb-3"><i class="bi bi-search me-1"></i>Find a shelter near you</h5>
      <form action="/victim/dashboard" method="GET" class="row g-2 align-items-end mb-3">
        <input type="hidden" name="tab" value="shelter">
        <div class="col-md-9">
          <label class="form-label">Search by shelter name or area</label>
          <input type="text" name="q" class="form-control" value="<%= q %>"
                 placeholder="e.g. Sector 4, Riverside, Northgate — leave blank to see all">
        </div>
        <div class="col-md-3 d-flex gap-2">
          <button type="submit" class="btn rl-btn-primary w-100">Search</button>
          <% if (q) { %>
            <a href="/victim/dashboard?tab=shelter" class="btn btn-outline-secondary">Clear</a>
          <% } %>
        </div>
      </form>

      <p class="text-muted small">
        <i class="bi bi-info-circle me-1"></i>
        Closed shelters are hidden. Shelters with the most space are shown first.
      </p>

      <% if (shelters.length === 0) { %>
        <div class="alert alert-warning py-2">
          <% if (q) { %>
            No open shelters match &ldquo;<%= q %>&rdquo;. Try a different area, or
            <a href="/victim/dashboard?tab=shelter">view all shelters</a>.
          <% } else { %>
            No shelters are open right now. You can still submit an aid request below and a
            coordinator will contact you.
          <% } %>
        </div>
      <% } else { %>
        <div class="row g-3 mb-4">
          <% shelters.forEach(function(s){ var pct = occupancyPct(s); %>
            <div class="col-md-6 col-lg-4">
              <div class="card rl-card h-100">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-start mb-1">
                    <h6 class="mb-0 fw-semibold"><%= s.name %></h6>
                    <span class="badge <%= shelterBadge(s.status) %>"><%= s.status %></span>
                  </div>
                  <p class="text-muted small mb-2">
                    <i class="bi bi-geo-alt me-1"></i><%= s.location %>
                  </p>

                  <div class="progress mb-1" style="height: 8px;" role="progressbar"
                       aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar <%= barColour(pct) %>" style="width: <%= pct %>%"></div>
                  </div>
                  <div class="d-flex justify-content-between small mb-3">
                    <span class="text-muted"><%= s.current_occupancy %> / <%= s.capacity %> occupied</span>
                    <span class="fw-semibold <%= s.free_spaces > 0 ? 'text-success' : 'text-danger' %>">
                      <%= s.free_spaces > 0 ? s.free_spaces + ' spaces free' : 'Full' %>
                    </span>
                  </div>

                  <button type="button"
                          class="btn btn-sm rl-btn-primary w-100 js-pick-shelter"
                          data-shelter-id="<%= s.id %>"
                          <%= s.free_spaces > 0 ? '' : 'disabled' %>>
                    <i class="bi bi-clipboard-plus me-1"></i>Request aid here
                  </button>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>

      <hr class="my-4">

      <!-- ---------- Register for aid ---------- -->
      <h5 class="mb-3" id="aid-form"><i class="bi bi-plus-circle me-1"></i>Register for aid</h5>
      <form action="/victim/aid-requests" method="POST" class="row g-2 align-items-end mb-4">
        <div class="col-md-3">
          <label class="form-label">Type of aid needed</label>
          <select name="need_type" class="form-select" required>
            <option value="">Choose…</option>
            <% needTypes.forEach(function(t){ %>
              <option value="<%= t %>"><%= t %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">People in your group</label>
          <input type="number" name="people_count" class="form-control"
                 min="1" max="500" value="1" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Preferred shelter</label>
          <select name="shelter_id" class="form-select" id="aidShelterSelect">
            <option value="">No preference</option>
            <% shelterOptions.forEach(function(s){ %>
              <option value="<%= s.id %>"><%= s.name %> — <%= s.location %> (<%= s.status %>)</option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn rl-btn-primary w-100">Submit</button>
        </div>
      </form>

      <!-- ---------- Track my aid requests ---------- -->
      <h5 class="mb-3"><i class="bi bi-list-check me-1"></i>My aid requests</h5>
      <% if (requests.length === 0) { %>
        <p class="text-muted">You have not registered for any aid yet. Use the form above.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Submitted</th>
                <th>Status</th>
                <th style="min-width:420px;">Aid needed, group size &amp; shelter</th>
                <th class="text-end">Withdraw</th>
              </tr>
            </thead>
            <tbody>
              <% requests.forEach(function(r){ %>
                <tr>
                  <td class="small text-muted"><%= new Date(r.created_at).toLocaleString() %></td>
                  <td><span class="badge <%= requestBadge(r.status) %>"><%= r.status %></span></td>
                  <td>
                    <% if (r.status === 'pending') { %>
                      <!-- Editable only while pending -->
                      <form action="/victim/aid-requests/<%= r.id %>/update" method="POST"
                            class="d-flex flex-wrap gap-1">
                        <select name="need_type" class="form-select form-select-sm" style="width:110px;">
                          <% needTypes.forEach(function(t){ %>
                            <option value="<%= t %>" <%= r.need_type === t ? 'selected' : '' %>><%= t %></option>
                          <% }); %>
                        </select>
                        <input type="number" name="people_count" class="form-control form-control-sm"
                               style="width:80px;" min="1" max="500" value="<%= r.people_count %>">
                        <select name="shelter_id" class="form-select form-select-sm" style="width:170px;">
                          <option value="">No preference</option>
                          <% shelterOptions.forEach(function(s){ %>
                            <option value="<%= s.id %>" <%= r.shelter_id === s.id ? 'selected' : '' %>>
                              <%= s.name %>
                            </option>
                          <% }); %>
                          <% // Their chosen shelter has since closed — keep it in the list
                             // so saving doesn't wipe the choice.
                             if (r.shelter_id && !shelterOptions.some(function(s){ return s.id === r.shelter_id; })) { %>
                            <option value="<%= r.shelter_id %>" selected><%= r.shelter_name %> (closed)</option>
                          <% } %>
                        </select>
                        <button class="btn btn-sm btn-outline-primary">Save</button>
                      </form>
                    <% } else { %>
                      <!-- Locked once a coordinator has picked it up -->
                      <span class="fw-semibold text-capitalize"><%= r.need_type %></span>
                      &middot; <%= r.people_count %> <%= r.people_count === 1 ? 'person' : 'people' %>
                      &middot;
                      <% if (r.shelter_name) { %>
                        <i class="bi bi-house-heart me-1"></i><%= r.shelter_name %>
                        <small class="text-muted">(<%= r.shelter_location %>)</small>
                      <% } else { %>
                        <span class="text-muted">No shelter assigned yet</span>
                      <% } %>
                      <div><small class="text-muted">
                        <i class="bi bi-lock me-1"></i>Locked — a coordinator is handling this request.
                      </small></div>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <% if (r.status === 'pending') { %>
                      <form action="/victim/aid-requests/<%= r.id %>/delete" method="POST"
                            onsubmit="return confirm('Withdraw this aid request?');">
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                      </form>
                    <% } else { %>
                      <span class="text-muted small">&mdash;</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- ================= TAB 2: EMERGENCY REPORTS ================= -->
    <div class="tab-pane fade <%= tab === 'reports' ? 'show active' : '' %>" id="reports-pane" role="tabpanel">

      <h5 class="mb-3"><i class="bi bi-broadcast me-1"></i>Report an emergency</h5>
      <div class="alert alert-danger py-2 small">
        <i class="bi bi-exclamation-triangle me-1"></i>
        Reports here go to relief coordinators. If life is in immediate danger,
        call the emergency services first.
      </div>

      <form action="/victim/reports" method="POST" class="row g-2 align-items-end mb-4">
        <div class="col-md-3">
          <label class="form-label">Emergency type</label>
          <select name="type" class="form-select" required>
            <option value="">Choose…</option>
            <% incidentTypes.forEach(function(t){ %>
              <option value="<%= t %>"><%= t %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">Location</label>
          <input type="text" name="location" class="form-control"
                 placeholder="e.g. Riverside, Sector 9" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">What is happening?</label>
          <input type="text" name="description" class="form-control"
                 placeholder="Describe the situation (min. 10 characters)" minlength="10" required>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn rl-btn-accent w-100">
            <i class="bi bi-send me-1"></i>Report
          </button>
        </div>
      </form>

      <h5 class="mb-3"><i class="bi bi-clock-history me-1"></i>My reports &amp; their status</h5>
      <% if (reports.length === 0) { %>
        <p class="text-muted">You have not submitted any emergency reports yet.</p>
      <% } else { %>
        <div class="row g-3">
          <% reports.forEach(function(rep){ %>
            <div class="col-12">
              <div class="card rl-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                      <h6 class="mb-1 fw-semibold text-capitalize">
                        <i class="bi bi-exclamation-octagon me-1 text-danger"></i><%= rep.type %>
                      </h6>
                      <p class="text-muted small mb-0">
                        <i class="bi bi-geo-alt me-1"></i><%= rep.location %>
                        <span class="ms-2"><i class="bi bi-calendar3 me-1"></i><%= new Date(rep.created_at).toLocaleString() %></span>
                      </p>
                    </div>
                    <span class="badge <%= reportBadge(rep.status) %>"><%= rep.status.replace('_', ' ') %></span>
                  </div>

                  <p class="mb-2"><%= rep.description %></p>

                  <!-- Status tracker -->
                  <div class="progress mb-3" style="height: 6px;">
                    <div class="progress-bar <%= rep.status === 'resolved' ? 'bg-success' : 'bg-primary' %>"
                         style="width: <%= rep.status === 'submitted' ? 33 : (rep.status === 'in_progress' ? 66 : 100) %>%"></div>
                  </div>
                  <div class="d-flex justify-content-between small text-muted mb-2">
                    <span>Submitted</span><span>In progress</span><span>Resolved</span>
                  </div>

                  <% if (rep.status === 'submitted') { %>
                    <button class="btn btn-sm btn-outline-primary" type="button"
                            data-bs-toggle="collapse" data-bs-target="#editReport<%= rep.id %>">
                      <i class="bi bi-pencil me-1"></i>Edit
                    </button>
                    <form action="/victim/reports/<%= rep.id %>/delete" method="POST" class="d-inline"
                          onsubmit="return confirm('Retract this emergency report?');">
                      <button class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash me-1"></i>Retract
                      </button>
                    </form>

                    <div class="collapse mt-3" id="editReport<%= rep.id %>">
                      <form action="/victim/reports/<%= rep.id %>/update" method="POST" class="row g-2 align-items-end">
                        <div class="col-md-3">
                          <label class="form-label small">Type</label>
                          <select name="type" class="form-select form-select-sm">
                            <% incidentTypes.forEach(function(t){ %>
                              <option value="<%= t %>" <%= rep.type === t ? 'selected' : '' %>><%= t %></option>
                            <% }); %>
                          </select>
                        </div>
                        <div class="col-md-3">
                          <label class="form-label small">Location</label>
                          <input type="text" name="location" class="form-control form-control-sm"
                                 value="<%= rep.location %>" required>
                        </div>
                        <div class="col-md-4">
                          <label class="form-label small">Description</label>
                          <input type="text" name="description" class="form-control form-control-sm"
                                 value="<%= rep.description %>" minlength="10" required>
                        </div>
                        <div class="col-md-2">
                          <button class="btn btn-sm rl-btn-primary w-100">Save changes</button>
                        </div>
                      </form>
                    </div>
                  <% } else { %>
                    <small class="text-muted">
                      <i class="bi bi-lock me-1"></i>Locked — responders are acting on this report.
                    </small>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

  </div>
</div>

<script>
  // "Request aid here" on a shelter card preselects that shelter in the aid form.
  document.querySelectorAll('.js-pick-shelter').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var select = document.getElementById('aidShelterSelect');
      if (select) select.value = btn.dataset.shelterId;
      var anchor = document.getElementById('aid-form');
      if (anchor) anchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

<%- include('../partials/footer') %>
