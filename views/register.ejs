<%- include('partials/header') %>

<h1>Create an account</h1>

<% if (error) { %>
  <div class="inset" style="border-left-color:var(--red)"><strong style="color:var(--red)"><%= error %></strong></div>
<% } %>

<div class="panel" style="max-width:560px">
  <form action="/register" method="POST" novalidate>
    <div class="field">
      <label for="name">Full name</label>
      <input type="text" id="name" name="name" value="<%= form.name || '' %>" required>
    </div>
    <div class="field">
      <label for="email">Email address</label>
      <input type="email" id="email" name="email" value="<%= form.email || '' %>" required>
    </div>
    <div class="field">
      <label for="password">Password</label>
      <div class="hint">Use at least 6 characters.</div>
      <input type="password" id="password" name="password" minlength="6" required>
    </div>
    <div class="field">
      <label for="role">Your role</label>
      <select id="role" name="role" required>
        <option value="" disabled <%= !form.role ? 'selected' : '' %>>Choose a role</option>
        <option value="admin"     <%= form.role === 'admin' ? 'selected' : '' %>>Coordinator</option>
        <option value="victim"    <%= form.role === 'victim' ? 'selected' : '' %>>Person needing help</option>
        <option value="volunteer" <%= form.role === 'volunteer' ? 'selected' : '' %>>Volunteer</option>
        <option value="donor"     <%= form.role === 'donor' ? 'selected' : '' %>>Donor</option>
      </select>
    </div>
    <button type="submit" class="btn">Create account</button>
  </form>
</div>

<p>Already have an account? <a href="/login">Sign in</a></p>

<%- include('partials/footer') %>
