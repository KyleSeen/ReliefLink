<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ReliefLink</title>
  <!-- Bootstrap 5 -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <!-- Bootstrap Icons -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    rel="stylesheet"
  />
  <!-- Shared custom styling -->
  <link href="/css/style.css" rel="stylesheet" />
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark rl-navbar">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">
        <i class="bi bi-life-preserver me-1"></i>ReliefLink
      </a>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#rlNav"
        aria-controls="rlNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="rlNav">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          <% if (currentUser) { %>
            <li class="nav-item">
              <span class="navbar-text me-3">
                <i class="bi bi-person-circle me-1"></i>
                <%= currentUser.name %>
                <span class="rl-role-badge"><%= currentUser.role %></span>
              </span>
            </li>
            <li class="nav-item">
              <a class="btn btn-sm btn-light" href="/logout">
                <i class="bi bi-box-arrow-right me-1"></i>Logout
              </a>
            </li>
          <% } else { %>
            <li class="nav-item">
              <a class="nav-link" href="/login">Login</a>
            </li>
            <li class="nav-item">
              <a class="btn btn-sm btn-light ms-lg-2" href="/register">Register</a>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <main class="rl-main">
