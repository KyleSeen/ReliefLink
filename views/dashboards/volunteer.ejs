<h1>Volunteer dashboard</h1>

<% var s = (typeof stats !== 'undefined' && stats) ? stats : {}; %>
<div class="stats">
  <div class="stat"><div class="num mono"><%= s.total || 0 %></div><div class="lbl">Tasks assigned</div></div>
  <div class="stat"><div class="num mono"><%= s.inProgress || 0 %></div><div class="lbl">In progress</div></div>
  <div class="stat green"><div class="num mono"><%= s.completed || 0 %></div><div class="lbl">Completed</div></div>
  <div class="stat"><div class="num mono"><%= s.logs || 0 %></div><div class="lbl">Log entries</div></div>
</div>

