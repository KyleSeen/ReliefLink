<%- include('partials/header') %>

<section class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
      <div class="card rl-auth-card">
        <div class="card-body p-4 p-md-5">
          <h3 class="mb-1 rl-section-title">Create your account</h3>
          <p class="text-muted mb-4">Join ReliefLink and start coordinating relief.</p>

          <% if (error) { %>
            <div class="alert alert-danger py-2"><%= error %></div>
          <% } %>

          <form action="/register" method="POST" novalidate>
            <div class="mb-3">
              <label class="form-label" for="name">Full name</label>
              <input type="text" class="form-control" id="name" name="name"
                     value="<%= form.name || '' %>" required />
            </div>
            <div class="mb-3">
              <label class="form-label" for="email">Email</label>
              <input type="email" class="form-control" id="email" name="email"
                     value="<%= form.email || '' %>" required />
            </div>
            <div class="mb-3">
              <label class="form-label" for="password">Password</label>
              <input type="password" class="form-control" id="password" name="password"
                     minlength="6" required />
              <div class="form-text">At least 6 characters.</div>
            </div>
            <div class="mb-4">
              <label class="form-label" for="role">Role</label>
              <select class="form-select" id="role" name="role" required>
                <option value="" disabled <%= !form.role ? 'selected' : '' %>>Choose a role…</option>
                <option value="admin"     <%= form.role === 'admin' ? 'selected' : '' %>>Admin / Coordinator</option>
                <option value="victim"    <%= form.role === 'victim' ? 'selected' : '' %>>Victim / Public User</option>
                <option value="volunteer" <%= form.role === 'volunteer' ? 'selected' : '' %>>Volunteer</option>
                <option value="donor"     <%= form.role === 'donor' ? 'selected' : '' %>>NGO / Donor</option>
              </select>
            </div>
            <button type="submit" class="btn rl-btn-primary w-100">Register</button>
          </form>

          <p class="text-center text-muted mt-4 mb-0">
            Already have an account? <a href="/login">Log in</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
