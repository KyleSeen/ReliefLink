<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ReliefLink</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet" />
</head>
<body>
  <header class="masthead">
    <div class="band">
      <a class="wordmark" href="/">ReliefLink</a>
      <span class="service-desc">Disaster Relief Coordination Platform</span>
    </div>
  </header>

  <nav class="service-nav">
    <div class="band">
      <% if (currentUser) { %>
        <span class="who"><%= currentUser.name %> <span class="role">(<%= currentUser.role %>)</span></span>
        <span class="links">
          <a href="/notifications" class="notif-bell">Notifications<% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %><span class="badge"><%= unreadCount %></span><% } %></a>
          <a href="/logout">Sign out</a>
        </span>
      <% } else { %>
        <span class="who">&nbsp;</span>
        <span class="links">
          <a href="/login" class="<%= (typeof nav !== 'undefined' && nav === 'login') ? 'active' : '' %>">Login</a>
          <a href="/register" class="<%= (typeof nav !== 'undefined' && nav === 'register') ? 'active' : '' %>">Register</a>
        </span>
      <% } %>
    </div>
  </nav>

  <main>
    <div class="wrap">
