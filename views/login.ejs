<%- include('partials/header') %>

<h1>Sign in</h1>

<% if (registered) { %>
  <div class="banner green"><div class="head">Account created</div><div class="body">You can sign in now.</div></div>
<% } %>
<% if (error) { %>
  <div class="inset" style="border-left-color:var(--red)"><strong style="color:var(--red)"><%= error %></strong></div>
<% } %>

<div class="panel" style="max-width:520px">
  <form action="/login" method="POST" novalidate>
    <div class="field">
      <label for="email">Email address</label>
      <input type="email" id="email" name="email" value="<%= form.email || '' %>" required>
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required>
    </div>
    <button type="submit" class="btn">Sign in</button>
  </form>
</div>

<p>No account yet? <a href="/register">Register</a></p>

<%- include('partials/footer') %>
